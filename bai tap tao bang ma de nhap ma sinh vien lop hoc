using System;
using System.Collections.Generic;
using System.ComponentModel.DataAnnotations;

public class SinhVien
{
    [Required]
    [RegularExpression(@"^Nam Nữ$",
        ErrorMessage = "GioiTinh must be Nam or Nữ")]
    public string GioiTinh { get; set; }

    [EmailAddress(ErrorMessage = "Invalid Email Address")]
    public string Email { get; set; }

    [Phone(ErrorMessage = "Invalid Phone Number")]
    public string SoDienThoai { get; set; }

    [Range(0, 10,
        ErrorMessage = "Diem must be between 0 and 10")]
    public double Diem { get; set; }

    public List<ValidationResult> IsInvalid()
    {
        var valcontext = new ValidationContext(this);
        var results = new List<ValidationResult>();

        var kt = Validator.TryValidateObject(
            this,
            valcontext,
            results,
            true
        );

        if (!kt)
        {
            return results;
        }
        else
        {
            return null;
        }
    }
